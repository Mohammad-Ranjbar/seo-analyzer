# Application
PORT=3000

# PostgreSQL 15 or newer. Replace every placeholder before use.
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/seo_analyzer"

# Integration tests only; the database name must end in _test.
DATABASE_TEST_URL="postgresql://postgres@localhost:5432/seo_analyzer_test"

# BullMQ worker and queue connection.
REDIS_URL="redis://localhost:6379/0"
