    @@map("workspace_member_roles")
  }

  model WorkspaceRolePermissions {
    workspaceRoleId Uuid              @map("workspace_role_id")
    permissionId    Uuid              @map("permission_id")
    grantedAt       TimestamptzString @map("granted_at")
    organizationId  Uuid              @map("organization_id")
    workspaceId     Uuid              @map("workspace_id")
    permission      Permissions       @relation(fields: [permissionId], references: [id], map: "workspace_role_permissions_permission_id_fkey", index: false)
    workspaceRoles  WorkspaceRoles    @relation(name: "workspace_role_permissions_role_scope_fk", fields: [organizationId, workspaceId, workspaceRoleId], references: [organizationId, workspaceId, id], onDelete: Cascade, map: "workspace_role_permissions_role_scope_fk", index: false)
    workspaceRole   WorkspaceRoles    @relation(name: "workspace_role_permissions_workspace_role_id_fkey", fields: [workspaceRoleId], references: [id], onDelete: Cascade, map: "workspace_role_permissions_workspace_role_id_fkey", index: "workspace_role_permissions_pkey")
    workspaces      Workspaces        @relation(fields: [organizationId, workspaceId], references: [organizationId, id], map: "workspace_role_permissions_workspace_tenant_fk", index: false)

    @@id([workspaceRoleId, permissionId], map: "workspace_role_permissions_pkey")
    @@rls
    @@map("workspace_role_permissions")
  }

