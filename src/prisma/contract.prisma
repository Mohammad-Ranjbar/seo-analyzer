namespace public {
  model AuditRules {
    id                Uuid                @id(map: "audit_rules_pkey")
    key               VarChar(160)        @unique(map: "audit_rules_key_key")
    name              VarChar(180)
    scope             VarChar(30)
    category          VarChar(60)
    createdAt         TimestamptzString   @map("created_at")
    auditRuleVersions AuditRuleVersions[]

    @@check(expression: "((scope)::text = ANY ((ARRAY['page'::character varying, 'site'::character varying])::text[]))", name: "managed_audit_rules_scope_check")
    @@rls
    @@map("audit_rules")
  }

  model AuditRuleVersions {
    id                    Uuid               @id(map: "audit_rule_versions_pkey")
    auditRuleId           Uuid               @map("audit_rule_id")
    version               Int
    severity              VarChar(20)
    parameters            Jsonb
    implementationVersion VarChar(80)        @map("implementation_version")
    publishedAt           TimestamptzString  @map("published_at")
    retiredAt             TimestamptzString? @map("retired_at")
    auditFindings         AuditFindings[]
    auditRule             AuditRules         @relation(fields: [auditRuleId], references: [id], map: "audit_rule_versions_audit_rule_id_fkey", index: "uq_audit_rule_versions_rule_version")

    @@index([auditRuleId, version], map: "uq_audit_rule_versions_rule_version", unique: true)
    @@check(expression: "((retired_at IS NULL) OR (retired_at >= published_at))", name: "managed_audit_rule_versions_retired_check")
    @@check(expression: "((severity)::text = ANY ((ARRAY['info'::character varying, 'warning'::character varying, 'error'::character varying])::text[]))", name: "managed_audit_rule_versions_severity_check")
    @@check(expression: "(version >= 1)", name: "managed_audit_rule_versions_version_check")
    @@rls
    @@map("audit_rule_versions")
  }

